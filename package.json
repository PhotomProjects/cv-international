{
    "name": "cv-site",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "watch:build": "chokidar \"src/**/*\" -c \"npm run build\"",
        "preview": "live-server dist --quiet --wait=300",
        "dev": "npm run build && concurrently -k \"npm:watch:build\" \"npm:preview\""
    },
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.2.1",
        "live-server": "^1.2.2",
        "serve": "^14.2.6"
    }
}
